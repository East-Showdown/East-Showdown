# Russian aircraft

entity = {
	name = "rus_aircraft_base_entity"
	pdxmesh = "rus_mig29_mesh"
	state = { name = "fire" animation = "idle" animation_speed = 1.0
		event = { time = 0 sound = { soundeffect = "airplane_jet_fire" } }
		event = { time = 0.5 sound = { soundeffect = "airplane_jet_fire" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_jet_fire" } }
	}
	state = { name = "bomb" animation = "idle" animation_speed = 1.0
		event = { time = 0 sound = { soundeffect = "airplane_bomb" } }
		event = { time = 0.5 sound = { soundeffect = "airplane_bomb" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_bomb" } }
	}
	state = { name = "idle" animation = "idle" animation_speed = 1.0
		event = { trigger_once = yes sound = { soundeffect = "airplane_heavy_idle_01" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_heavy_idle_01" } }
	}
	state = { name = "crash" animation = "idle" animation_speed = 1.0
		event = { time = 0 sound = { soundeffect = "airplane_crash" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_crash" } }
	}
	state = { name = "explode" animation = "idle" animation_speed = 1.0
		event = { time = 0 particle = "vehicle_explode_effect" keep_particle = yes }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_crash" } }
	}

}

