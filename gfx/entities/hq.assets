entity = {
	name = "RUS_army_weapon_pistol_right_entity"
	pdxmesh = "RUS_infantry_1"
	scale = 0.9

	get_state_from_parent = yes
	default_state = "idle"
	state = { name = "idle" }
	state = { name = "move" }

	state = { name = "attack"	animation = "attack"
		event = { time = 1.5 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
		event = { time = 1.8 node="cartridge" particle = "rifle_cartridge_particle"  keep_particle = yes }
	}

#German pistol stance
	state = { name = "defend"
		event = { time = 0 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
		event = { time = 0.3 node="cartridge" particle = "rifle_cartridge_particle"  keep_particle = yes }
		event = { time = 0.6 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
		event = { time = 0.9 node="cartridge" particle = "rifle_cartridge_particle"  keep_particle = yes }
		event = { time = 2.87 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
		event = { time = 2.9 node="cartridge" particle = "rifle_cartridge_particle"  keep_particle = yes }
		#event = { time = 1 node="muzzle" particle = "mg_muzzle_smoke_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
	}

#Crouched stance
	state = { name = "support_attack"
		event = { time = 0 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" } }
		event = { time = 0.55 node="muzzle" particle = "pistol_muzzle_particle"  keep_particle = yes   light = "rifle_muzzle_flash" sound = { soundeffect = "pistol_luger_fire" }  }
	}
}

