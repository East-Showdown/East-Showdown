# Dedicated exterior model for Kh-47M2 Kinzhal.
entity = {
    name = "rus_kinzhal_entity"
    pdxmesh = "rus_kinzhal_mesh"
    scale = 0.60
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "launch" animation = "launch" looping = no next_state = "idle" }
    state = { name = "move" animation = "idle" looping = yes }
    state = { name = "bomb" animation = "idle" looping = yes }
    state = { name = "crash" animation = "idle" looping = no }
    state = { name = "explode" animation = "idle" looping = no }
}
