# Independent entity: do not inherit the unresolved missile_default_entity.
entity = {
    name = "rus_shahed_entity"
    pdxmesh = "rus_shahed_mesh"
    scale = 0.65
    default_state = "idle"
    state = { name = "idle" animation = "fly" looping = yes }
    state = { name = "launch" animation = "fly" looping = no next_state = "idle" }
    state = { name = "move" animation = "fly" looping = yes }
    state = { name = "bomb" animation = "fly" looping = yes }
    state = { name = "crash" animation = "fly" looping = no }
    state = { name = "explode" animation = "fly" looping = no }
}
