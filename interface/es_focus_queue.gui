# ES focus queue - panel layout (hand-written). Based on the FFU focus queue panel.
guiTypes = {
	containerWindowType = {
		name = es_fq_open_window
		position = { x = 330 y = 6 }

		buttonType = {
			name = es_fq_open
			position = { x = 0 y = 0 }
			quadTextureSprite = GFX_button_148x34
			buttonText = "es_fq_open_label"
			buttonFont = hoi_16mbs
			clicksound = click_default
			pdx_tooltip = es_fq_open_tt
		}
	}

	containerWindowType = {
		name = es_fq_panel
		position = { x = 15 y = 48 }
		size = { width = 495 height = 620 }
		moveable = yes
		click_to_front = yes
		clipping = no

		background = {
			name = Background
			spriteType = GFX_tiled_plain_bg
		}

		instantTextboxType = {
			name = title
			position = { x = 0 y = 10 }
			text = "es_fq_title"
			font = hoi_36header
			maxWidth = 495
			maxHeight = 30
			format = center
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = description
			position = { x = 10 y = 50 }
			text = "es_fq_description"
			font = hoi_16mbs
			maxWidth = 470
			maxHeight = 40
			format = left
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = instruction
			position = { x = 10 y = 96 }
			text = "es_fq_instruction"
			font = hoi_16mbs
			maxWidth = 470
			maxHeight = 44
			format = left
			alwaystransparent = yes
		}

		containerWindowType = {
			name = toolbar
			position = { x = 0 y = 140 }
			size = { width = 495 height = 40 }

			background = {
				name = Background
				spriteType = GFX_tiled_decisions_bg_small
				alwaystransparent = yes
			}

			instantTextboxType = {
				name = queue_title
				position = { x = 10 y = 10 }
				text = "es_fq_queue_title"
				font = hoi_16mbs
				maxWidth = 170
				maxHeight = 24
				format = left
				alwaystransparent = yes
			}

			buttonType = {
				name = es_fq_pause
				position = { x = 182 y = 3 }
				quadTextureSprite = GFX_button_148x34
				buttonText = "es_fq_pause"
				buttonFont = hoi_16mbs
				clicksound = click_default
				pdx_tooltip = es_fq_pause_tt
			}

			buttonType = {
				name = es_fq_buttons
				position = { x = 334 y = 7 }
				quadTextureSprite = GFX_small_button_71x26
				buttonText = "es_fq_buttons"
				buttonFont = hoi_16mbs
				clicksound = click_default
				pdx_tooltip = es_fq_buttons_tt
			}

			buttonType = {
				name = es_fq_clear
				position = { x = 412 y = 7 }
				quadTextureSprite = GFX_small_button_71x26
				buttonText = "es_fq_clear"
				buttonFont = hoi_16mbs
				clicksound = click_default
				pdx_tooltip = es_fq_clear_tt
			}
		}

		containerWindowType = {
			name = es_fq_queue_scroll
			position = { x = 0 y = 180 }
			size = { width = 495 height = 380 }
			margin = { top = 10 left = 10 bottom = 10 }
			clipping = yes
			verticalScrollbar = right_vertical_slider
			vertical_scroll_step = 55
			scroll_wheel_factor = 40
			smooth_scrolling = yes

			background = {
				name = Background
				quadTextureSprite = GFX_tiled_window2_1b_border
			}

			gridBoxType = {
				name = es_fq_queue_grid
				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 462 height = 53 }
				max_slots_horizontal = 1
				add_horizontal = no
				format = UPPER_LEFT
			}
		}

		buttonType = {
			name = es_fq_close
			position = { x = -36 y = 4 }
			quadTextureSprite = GFX_closebutton
			orientation = UPPER_RIGHT
			shortcut = ESCAPE
			clicksound = click_close
			pdx_tooltip = CLOSE
		}

		instantTextboxType = {
			name = status
			position = { x = 10 y = 572 }
			text = "[es_fq_status]"
			font = hoi_16mbs
			maxWidth = 470
			maxHeight = 40
			format = left
			alwaystransparent = yes
		}
	}

	containerWindowType = {
		name = es_fq_queue_entry
		size = { width = 462 height = 53 }

		buttonType = {
			name = es_fq_pick
			position = { x = 0 y = 0 }
			quadTextureSprite = GFX_idea_entry_bg_4
			buttonText = ""
			buttonFont = hoi_16mbs
			clicksound = click_default
			pdx_tooltip = es_fq_move_tt
		}

		iconType = {
			name = number_frame
			position = { x = 20 y = 18 }
			spriteType = GFX_generic_circle_background
			frame = 5
			scale = 1.3
			alwaystransparent = yes
		}

		iconType = {
			name = es_fq_first
			position = { x = 20 y = 18 }
			spriteType = GFX_generic_circle_background
			frame = 1
			scale = 1.3
			alwaystransparent = yes
		}

		iconType = {
			name = es_fq_running
			position = { x = 20 y = 18 }
			spriteType = GFX_generic_circle_background
			frame = 3
			scale = 1.3
			alwaystransparent = yes
		}

		iconType = {
			name = es_fq_selected
			position = { x = 20 y = 18 }
			spriteType = GFX_generic_circle_background
			frame = 2
			scale = 1.3
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = queue_number
			position = { x = 21 y = 21 }
			text = "[es_fq_queue_position]"
			font = hoi_16mbs
			maxWidth = 20
			maxHeight = 24
			format = center
			alwaystransparent = yes
		}

		iconType = {
			name = es_fq_icon
			position = { x = 48 y = 8 }
			spriteType = GFX_goal_unknown
			scale = 0.50
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = es_fq_name
			position = { x = 95 y = 7 }
			text = "[es_fq_focus_name]"
			font = hoi_18mbs
			maxWidth = 314
			maxHeight = 40
			format = left
			alwaystransparent = yes
		}

		buttonType = {
			name = es_fq_remove
			position = { x = 420 y = 11 }
			quadTextureSprite = GFX_closebutton
			buttonText = ""
			buttonFont = hoi_16mbs
			clicksound = click_default
			pdx_tooltip = es_fq_remove_tt
		}
	}
}
