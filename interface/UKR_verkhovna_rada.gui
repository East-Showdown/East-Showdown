guiTypes = {
	containerWindowType = {
		name = "verkhovna_rada_open_button"
		position = { x = -405 y = 0 }
		Orientation = UPPER_RIGHT
		origo = UPPER_RIGHT
		buttonType = {
			name = "open_verkhovna_rada_screen_button"
			spriteType = "GFX_UKR_verkhovna_rada_button"
			position = { x = 0 y = 0 }
			pdx_tooltip = "OPEN_UKR_verkhovna_rada_BUTTON_text"
			pdx_tooltip_delayed = "OPEN_UKR_verkhovna_rada_BUTTON_TT_text"
		}
	}

    containerWindowType = {
        name = "verkhovna_rada_solutions_container"
		position = { x=15 y = 350 }
		size = { width = 260     height = 285 }
		margin = { top = 8 bottom = 8 }
		verticalScrollbar = "left_vertical_slider"

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_window_transparent"
		}

		gridboxType = {
			name = "verkhovna_rada_available_solutions_list"
			position = { x = 30 y = 0 }
			padding = { top = 50 bottom = 0 }
			size = { width = 100%% height = 100%% }
			slotsize = { width = 500 height = 35 }
			format = "UPPER_LEFT"
			max_slots_horizontal = 1
		}
    }

    containerWindowType = {
        name = "verkhovna_rada_available_solutions_list_container"

        # Общий фон заголовка категории
        iconType = {
            name = "verkhovna_rada_category_header_bg"
            position = { x = 0 y = 0 }
            spriteType = "GFX_ukr_vr_category_header_bg"
        }

        # Картинка для евроинтеграции
        iconType = {
            name = "verkhovna_rada_european_integration_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_economic_icon"
        }

        # Картинка для внутриполит решения
        iconType = {
            name = "verkhovna_rada_domestic_policy_decisions_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_political_icon"
        }

        # Картинка для экономических решений
        iconType = {
            name = "verkhovna_rada_economic_decisions_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_military_icon"
        }

        # Картинка для внешнеполит решений
        iconType = {
            name = "verkhovna_rada_foreign_policy_decisions_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_military_icon"
        }

        # Картинка для общественных решений
        iconType = {
            name = "verkhovna_rada_public_decisions_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_military_icon"
        }

        # Картинка для военных решений
        iconType = {
            name = "verkhovna_rada_military_decisions_category_icon"
            position = { x = 8 y = 5 }
            spriteType = "GFX_ukr_vr_military_icon"
        }

        # Текст заголовка категории
        instantTextBoxType = {
            name = "verkhovna_rada_category_header_text"
            position = { x = 40 y = 8 }
            font = "hoi_18mbs"
            text = "[name_of_solution_category]"
            format = left
            maxWidth = 250
            maxHeight = 30
        }

        # Обычная кнопка решения
        buttonType = {
            name = "verkhovna_rada_available_solutions_button"
            position = { x = 0 y = 3 }
            quadTextureSprite = "GFX_button_221x34"
            buttonFont = "hoi_16mbs"
            Orientation = "UPPER_LEFT"
            buttonText = "[name_of_solution]"
            clicksound = click_close
        }
    }

