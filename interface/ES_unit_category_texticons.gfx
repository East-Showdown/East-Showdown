# East Showdown: small (60x12, 2 frames) icons for every ES sub-unit and unit category.
# Used by division tooltips/texticons (unit_<key>_icon_small, unit_category_<cat>_icon_small) and small counters.
# This file is the only definition of these sprites; duplicates were removed from texticons.gfx, ES_texticons.gfx and subuniticons.gfx.
# Images are ES counters from gfx/interface/counters/divisions_small or downscaled ES divisions_large counters in gfx/texticons.
spriteTypes = {

	### Sub-units: common/units/apc.txt
	spriteType = {
		name = "GFX_unit_apc_icon_small"
